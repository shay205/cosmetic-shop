# Copy this file to .env and fill in credentials locally.
# Do not put real credentials in this file.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret
MPESA_SHORTCODE=your_sandbox_shortcode
MPESA_PASSKEY=your_sandbox_passkey
MPESA_CALLBACK_URL=https://your-public-https-host.example.com/mpesa/callback/
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Email delivery: local development prints verification email in the runserver console.
# Configure your provider's SMTP details before deploying.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Glow Beauty <noreply@example.com>
